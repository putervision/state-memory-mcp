# State-Memory-MCP Environment Configuration

# Custom data directory location for state-memory-mcp SQLite storage databases
STATE_MEMORY_MCP_DATA_DIR=

# Minimum log level: debug | info | warn | error
STATE_MEMORY_MCP_LOG_LEVEL=info

# Default project identifier (falls back to directory name or git repo name)
STATE_MEMORY_MCP_PROJECT=

# Default git branch filter (falls back to current git checkout branch or 'main')
STATE_MEMORY_MCP_DEFAULT_BRANCH=main

# Strict audit trail enforcement: true | false
STATE_MEMORY_STRICT_AUDIT=false
