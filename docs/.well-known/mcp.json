{
  "$schema": "https://modelcontextprotocol.io/schemas/mcp-manifest.json",
  "name": "PuterVision MCP Ecosystem",
  "vendor": "PuterVision",
  "description": "Deterministic multi-modal state memory, visual perception caching, 3D spatial world models, ~60Hz behavior trees, and strategic BDI reasoning MCP servers for autonomous AI agents.",
  "homepage": "https://statememorymcp.com",
  "documentation": "https://putervision.com/llms.txt",
  "servers": [
    {
      "id": "state-memory-mcp",
      "name": "State Memory MCP",
      "package": "@putervision/state-memory-mcp",
      "version": "1.2.1",
      "command": "npx",
      "args": [
        "-y",
        "@putervision/state-memory-mcp"
      ],
      "homepage": "https://statememorymcp.com",
      "repository": "https://github.com/putervision/state-memory-mcp",
      "capabilities": [
        "tasks",
        "decisions",
        "blockers",
        "plans",
        "artifacts",
        "sdd",
        "3d-visualizer"
      ],
      "protocolVersion": "2024-11-05"
    },
    {
      "id": "vision-memory-mcp",
      "name": "Visual Memory MCP",
      "package": "@putervision/vision-memory-mcp",
      "version": "1.2.1",
      "command": "npx",
      "args": [
        "-y",
        "@putervision/vision-memory-mcp"
      ],
      "homepage": "https://visionmemorymcp.com",
      "repository": "https://github.com/putervision/vision-memory-mcp",
      "capabilities": [
        "dhash-fastpath",
        "clip-vector-search",
        "layout-drift-detection",
        "screenshot-caching",
        "video-keyframe-timeline"
      ],
      "protocolVersion": "2024-11-05"
    },
    {
      "id": "world-model-mcp",
      "name": "Spatial World Model MCP",
      "package": "@putervision/world-model-mcp",
      "version": "0.4.1",
      "command": "npx",
      "args": [
        "-y",
        "@putervision/world-model-mcp"
      ],
      "homepage": "https://worldmodelmcp.com",
      "repository": "https://github.com/putervision/world-model-mcp",
      "capabilities": [
        "spatial-memory",
        "object-permanence",
        "collision-simulation",
        "frustum-culling",
        "game-inputs"
      ],
      "protocolVersion": "2024-11-05"
    },
    {
      "id": "behavior-mcp",
      "name": "Behavior Runtime MCP",
      "package": "@putervision/behavior-mcp",
      "version": "0.2.1",
      "command": "npx",
      "args": [
        "-y",
        "@putervision/behavior-mcp"
      ],
      "homepage": "https://behaviormcp.com",
      "repository": "https://github.com/putervision/behavior-mcp",
      "capabilities": [
        "behavior-trees",
        "60hz-runtime",
        "reactive-triggers",
        "action-recordings",
        "safety-stack"
      ],
      "protocolVersion": "2024-11-05"
    },
    {
      "id": "agent-reasoning-mcp",
      "name": "Agent Reasoning MCP",
      "package": "@putervision/agent-reasoning-mcp",
      "version": "0.2.1",
      "command": "npx",
      "args": [
        "-y",
        "@putervision/agent-reasoning-mcp"
      ],
      "homepage": "https://agentreasoningmcp.com",
      "repository": "https://github.com/putervision/agent-reasoning-mcp",
      "capabilities": [
        "bdi-reasoning",
        "goal-dags",
        "utility-evaluation",
        "belief-decay",
        "replanning",
        "decision-traces"
      ],
      "protocolVersion": "2024-11-05"
    },
    {
      "id": "harness",
      "name": "PuterVision Harness",
      "package": "@putervision/harness",
      "version": "0.2.0",
      "command": "npx",
      "args": [
        "-y",
        "@putervision/harness"
      ],
      "homepage": "https://putervision.com",
      "repository": "https://github.com/putervision/harness",
      "capabilities": [
        "process-supervision",
        "gateway-proxy",
        "ooda-loop",
        "hud-slicer",
        "aim-smoothing",
        "gym-bridge"
      ],
      "protocolVersion": "2024-11-05"
    }
  ]
}
