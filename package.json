{
  "name": "state-graph-mcp",
  "version": "0.2.1",
  "description": "Deterministic, persistent graph server for tracking workflow state, decisions, and blockers.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "state-graph-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "Lucas Armstrong",
  "homepage": "https://github.com/LucasArmstrong/state-graph-mcp#readme",
  "bugs": {
    "url": "https://github.com/LucasArmstrong/state-graph-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "model-context-protocol-server",
    "state-graph",
    "workflow",
    "workflow-state",
    "dependency-graph",
    "decision-tracking",
    "decision-log",
    "task-tracking",
    "cli",
    "ai-agents",
    "ai-assistant",
    "cursor",
    "cursor-rules",
    "claude-code",
    "windsurf",
    "sqlite",
    "project-management",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucasArmstrong/state-graph-mcp.git"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --clean --dts",
    "dev": "tsup src/index.ts src/cli.ts --format esm --watch --onSuccess 'node dist/index.js'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts tests/**/*.ts",
    "format:check": "prettier --check src/**/*.ts tests/**/*.ts",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "prepublishOnly": "npm run build",
    "release": "npm publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.12.7",
    "eslint": "^9.0.0",
    "prettier": "^3.2.5",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
