{
  "name": "@putervision/state-memory-mcp",
  "version": "0.9.32",
  "description": "Deterministic, persistent graph server for tracking workflow state, decisions, and blockers.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "model-context-protocol-server",
    "state-memory",
    "workflow",
    "workflow-state",
    "dependency-graph",
    "decision-tracking",
    "decision-log",
    "task-tracking",
    "cli",
    "ai-agents",
    "ai-assistant",
    "cursor",
    "cursor-rules",
    "claude-code",
    "windsurf",
    "sqlite",
    "project-management",
    "developer-tools",
    "event-sourcing",
    "audit-trail",
    "context-snapshots",
    "trajectory-export",
    "fine-tuning-data",
    "state-rollback",
    "undo-last"
  ],
  "homepage": "https://statememorymcp.com",
  "bugs": {
    "url": "https://github.com/putervision/state-memory-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/putervision/state-memory-mcp.git"
  },
  "mcpName": "io.github.putervision/state-memory-mcp",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "PuterVision LLC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "state-memory-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "server.json",
    "manifest.json"
  ],
  "scripts": {
    "build": "tsup",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "cli": "node dist/cli.js",
    "dev": "tsup --watch --onSuccess 'node dist/index.js'",
    "format": "prettier --write src/**/*.ts tests/**/*.ts",
    "format:check": "prettier --check src/**/*.ts tests/**/*.ts",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "npm run build",
    "release": "npm publish",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:matrix": "bash scripts/test-matrix.sh",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.12.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsup": "^8.1.0",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "esbuild": "^0.28.1",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
